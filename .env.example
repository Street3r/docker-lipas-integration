# URL under which data/output is served. Baked into the KML network links, so it
# must be reachable from the TAK clients and should not change once links are shared.
# Internal network example: http://<server LAN IP>:8080  (and WEB_BIND=0.0.0.0:8080)
# Public example:           https://tak-data.example.org/lipas2tak
PUBLIC_BASE_URL=http://localhost:8080

# Generator image. Default: built locally from the ../python-lipas2tak-tool clone.
# Prebuilt public image from ghcr (no login needed; tags: main, a version such as 0.1.0):
# LIPAS2TAK_IMAGE=ghcr.io/street3r/python-lipas2tak-tool:main
# LIPAS2TAK_BUILD_CONTEXT=../python-lipas2tak-tool

# Update interval in days
LIPAS2TAK_EVERY_DAYS=7

# nginx bind address: 127.0.0.1:8080 behind a reverse proxy,
# <server LAN IP>:8080 or 0.0.0.0:8080 for direct access from the internal network
WEB_BIND=127.0.0.1:8080

# --- Publishing to GitHub (optional) ---------------------------------------
# Enable the publisher container: uncomment COMPOSE_PROFILES=github.
# It builds a public version (always with the default icon set) after every
# generator run and force-pushes it to the branch below. See README.
# COMPOSE_PROFILES=github
# PUBLISH_REPO=git@github.com:Street3r/finland-outdoor-tak-data.git
# If the network resets large pushes on port 22 ("Connection reset by peer",
# "the remote end hung up unexpectedly"), use GitHub's SSH endpoint on port 443:
# PUBLISH_REPO=ssh://git@ssh.github.com:443/Street3r/finland-outdoor-tak-data.git
# PUBLISH_BRANCH=data
# PUBLISH_BASE_URL=https://street3r.github.io/finland-outdoor-tak-data
# PUBLISH_DEPLOY_KEY=./secrets/github_deploy_key

# Icon set. Empty = the tool's own pictogram set (icons/retkeily).
# For a custom set, put the PNGs in this repository's icons/ folder
# (file names: see python-lipas2tak-tool/icons/README.md) and set:
# LIPAS2TAK_ICONS_DIR=/app/icons/custom
LIPAS2TAK_ICONS_DIR=
