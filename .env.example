# Julkinen osoite, jonka alla data/output näkyy (KML-verkkolinkit käyttävät tätä)
PUBLIC_BASE_URL=https://lipas.example.org

# Generaattorin image (yksityinen ghcr-paketti vaatii: docker login ghcr.io)
LIPAS2TAK_IMAGE=ghcr.io/street3r/python-lipas2tak-tool:main

# Päivitysväli päivinä
LIPAS2TAK_EVERY_DAYS=7

# nginx: mihin osoitteeseen sidotaan (reverse proxy edessä)
WEB_BIND=127.0.0.1:8080
